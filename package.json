{
  "name": "astro-desktop",
  "version": "0.1.0",
  "description": "Offline-First Native Desktop AI Assistant & Coding Studio",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/**/*.test.js",
    "check-hw": "node scripts/check-hardware.js",
    "build": "electron-builder --win",
    "build:installer": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:dir": "electron-builder --win dir",
    "generate:checksums": "node scripts/verify-release-checksums.js --generate",
    "verify:checksums": "node scripts/verify-release-checksums.js --verify"
  },
  "keywords": [
    "desktop",
    "offline-ai",
    "local-rag",
    "qwen",
    "gguf",
    "electron"
  ],
  "author": "Aditya & Anti-Gravity",
  "license": "MIT",
  "dependencies": {
    "node-llama-cpp": "^3.22.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.astro.desktop",
    "productName": "ASTRO",
    "copyright": "Copyright © 2026 Aditya & Anti-Gravity",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!Qwen3-8B-Q4_K_M.gguf",
      "!*.gguf",
      "!*.bin",
      "!tests/**/*",
      "!scripts/**/*",
      "!docs/**/*",
      "!.astro_data/**/*",
      "!scratch/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node-llama-cpp/**",
      "**/@node-llama-cpp/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ASTRO",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
